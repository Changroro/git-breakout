[Unit]
Description=Check GitHub Trend Radar public health
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
Environment=TREND_RADAR_PUBLIC_URL=https://github-trend-radar.imbch.dev
Environment=TREND_RADAR_MIN_FREE_PERCENT=20
ExecStart=/usr/bin/bash /home/ubuntu/github-trend-radar/deploy/oracle/healthcheck.sh
