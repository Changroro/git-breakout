[Unit]
Description=Verify GitBreakout backup restore
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=ubuntu
Environment=TREND_RADAR_REPO=/home/ubuntu/github-trend-radar
Environment=TREND_RADAR_BACKUP_DIR=/home/ubuntu/backups/github-trend-radar
ExecStart=/usr/bin/bash /home/ubuntu/github-trend-radar/deploy/oracle/verify-backup.sh
