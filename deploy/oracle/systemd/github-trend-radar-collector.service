[Unit]
Description=Collect GitHub Trend Radar repository rankings
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
User=ubuntu
Environment=HOME=/home/ubuntu
Environment=TREND_RADAR_REPO=/home/ubuntu/github-trend-radar
EnvironmentFile=/home/ubuntu/github-trend-radar/deploy/oracle/.env
ExecStart=/usr/bin/bash /home/ubuntu/github-trend-radar/deploy/oracle/collect-cycle.sh
TimeoutStartSec=45min
UMask=0077
