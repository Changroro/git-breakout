[Unit]
Description=Deploy GitHub Trend Radar from main
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
User=ubuntu
Environment=TREND_RADAR_REPO=/home/ubuntu/github-trend-radar
Environment=TREND_RADAR_STATE_DIR=/home/ubuntu/.local/state/github-trend-radar
ExecStart=/usr/bin/bash /usr/local/sbin/github-trend-radar-deploy
