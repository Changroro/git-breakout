diff --git a/deploy/oracle/db/migrations/024_board_track_record.sql b/deploy/oracle/db/migrations/024_board_track_record.sql
new file mode 100644
index 0000000..b89d2d8
--- /dev/null
+++ b/deploy/oracle/db/migrations/024_board_track_record.sql
@@ -0,0 +1,309 @@
+begin;
+
+create table if not exists radar.discovery_board_exposures (
+  full_name_key text primary key,
+  full_name text not null check (full_name ~ '^[^/[:space:]]+/[^/[:space:]]+$'),
+  first_board_at timestamptz not null,
+  first_board_rank integer not null check (first_board_rank > 0),
+  first_board_stars integer not null check (first_board_stars >= 0),
+  first_top10_at timestamptz,
+  first_top10_stars integer check (first_top10_stars >= 0),
+  board_hit_7d boolean,
+  top10_hit_7d boolean,
+  check ((first_top10_at is null) = (first_top10_stars is null)),
+  check (first_top10_at is null or first_top10_at >= first_board_at),
+  check (first_top10_at is not null or top10_hit_7d is null)
+);
+
+alter table radar.discovery_board_exposures enable row level security;
+alter table radar.discovery_board_exposures force row level security;
+drop policy if exists discovery_board_exposures_collector on radar.discovery_board_exposures;
+create policy discovery_board_exposures_collector on radar.discovery_board_exposures
+  for all to collector using (true) with check (true);
+grant select, insert, update on radar.discovery_board_exposures to collector;
+
+-- 발굴 보드 순서는 api.snapshot_page의 breakout 정렬과 같아야 한다.
+create or replace function radar.record_board_exposures(p_snapshot_id uuid)
+returns void language sql set search_path = pg_catalog, radar as $$
+  with board as (
+    select full_name_key, full_name, captured_at, stars,
+      row_number() over (
+        order by (payload_json #>> '{trend_intelligence,breakout,score}')::numeric desc, full_name_key
+      )::integer as position
+    from radar.snapshot_repositories
+    where snapshot_id = p_snapshot_id
+      and payload_json #> '{trend_intelligence,breakout,score}' <> 'null'::jsonb
+  )
+  insert into radar.discovery_board_exposures as exposures (
+    full_name_key, full_name, first_board_at, first_board_rank, first_board_stars,
+    first_top10_at, first_top10_stars
+  )
+  select full_name_key, full_name, captured_at, position, stars,
+    case when position <= 10 then captured_at end,
+    case when position <= 10 then stars end
+  from board
+  on conflict (full_name_key) do update
+    set first_top10_at = excluded.first_top10_at, first_top10_stars = excluded.first_top10_stars
+    where exposures.first_top10_at is null and excluded.first_top10_at is not null;
+$$;
+revoke execute on function radar.record_board_exposures(uuid) from public;
+grant execute on function radar.record_board_exposures(uuid) to collector;
+
+-- 노출 후 7일 안에 Daily Trending에 들거나 Star가 500개 이상 늘면 적중이다. 기준을 바꾸면 compute_track_record의 hit_rule도 바꾼다.
+create or replace function radar.board_hit_7d(p_full_name_key text, p_shown_at timestamptz, p_shown_stars integer)
+returns boolean language sql stable set search_path = pg_catalog, radar as $$
+  select coalesce((
+      select first_official_daily_at > p_shown_at
+        and first_official_daily_at <= p_shown_at + interval '7 days'
+      from radar.repository_discovery_milestones
+      where full_name_key = p_full_name_key
+    ), false)
+    or coalesce((
+      select max(stars) - p_shown_stars >= 500
+      from radar.snapshot_repositories
+      where full_name_key = p_full_name_key
+        and captured_at > p_shown_at
+        and captured_at <= p_shown_at + interval '7 days'
+    ), false);
+$$;
+revoke execute on function radar.board_hit_7d(text, timestamptz, integer) from public;
+grant execute on function radar.board_hit_7d(text, timestamptz, integer) to collector;
+
+create or replace function radar.settle_board_outcomes(p_latest_captured_at timestamptz)
+returns void language sql set search_path = pg_catalog, radar as $$
+  update radar.discovery_board_exposures
+  set board_hit_7d = radar.board_hit_7d(full_name_key, first_board_at, first_board_stars)
+  where board_hit_7d is null and first_board_at + interval '7 days' <= p_latest_captured_at;
+
+  update radar.discovery_board_exposures
+  set top10_hit_7d = radar.board_hit_7d(full_name_key, first_top10_at, first_top10_stars)
+  where top10_hit_7d is null and first_top10_at + interval '7 days' <= p_latest_captured_at;
+$$;
+revoke execute on function radar.settle_board_outcomes(timestamptz) from public;
+grant execute on function radar.settle_board_outcomes(timestamptz) to collector;
+
+create or replace function radar.compute_track_record()
+returns jsonb
+language plpgsql
+stable
+set search_path = pg_catalog, radar
+as $$
+declare
+  latest_captured_at timestamptz;
+  result jsonb;
+begin
+  select max(captured_at) into latest_captured_at from radar.snapshots;
+  if latest_captured_at is null then
+    raise exception 'Discovery track record requires at least one snapshot';
+  end if;
+
+  with classified as (
+    select
+      milestones.*,
+      milestones.first_observation_sources is not null
+        and milestones.first_observation_sources && array[
+          'github_search_created',
+          'github_search_pushed',
+          'gh_archive'
+        ]::text[]
+        and not milestones.first_observation_sources && array[
+          'official_daily',
+          'official_weekly',
+          'official_monthly'
+        ]::text[] as eligible
+    from radar.repository_discovery_milestones milestones
+  ), conversions as (
+    select
+      count(*) filter (
+        where eligible and not coverage_gap
+          and latest_captured_at >= first_observed_at + interval '7 days'
+      )::integer as eligible_7d,
+      count(*) filter (
+        where eligible and not coverage_gap
+          and latest_captured_at >= first_observed_at + interval '7 days'
+          and first_official_daily_at <= first_observed_at + interval '7 days'
+      )::integer as converted_7d,
+      count(*) filter (
+        where eligible and not coverage_gap
+          and latest_captured_at >= first_observed_at + interval '14 days'
+      )::integer as eligible_14d,
+      count(*) filter (
+        where eligible and not coverage_gap
+          and latest_captured_at >= first_observed_at + interval '14 days'
+          and first_official_daily_at <= first_observed_at + interval '14 days'
+      )::integer as converted_14d
+    from classified
+  ), recent_hits as (
+    select *
+    from classified
+    where eligible and not coverage_gap and first_official_daily_at > first_observed_at
+    order by first_official_daily_at desc, full_name_key
+    limit 5
+  ), summary as (
+    select
+      min(first_observed_at) filter (where eligible) as evidence_started_at,
+      count(*) filter (
+        where eligible and not coverage_gap and first_official_daily_at > first_observed_at
+      )::integer as verified_count,
+      percentile_cont(0.5) within group (
+        order by extract(epoch from (first_official_daily_at - first_observed_at)) / 3600
+      ) filter (
+        where eligible and not coverage_gap and first_official_daily_at > first_observed_at
+      ) as median_lead_hours,
+      count(*) filter (
+        where eligible and not coverage_gap and first_official_daily_at > first_observed_at
+      )::integer as daily_hits,
+      count(*) filter (
+        where eligible and not coverage_gap and first_official_weekly_at > first_observed_at
+      )::integer as weekly_hits,
+      count(*) filter (
+        where eligible and not coverage_gap and first_official_monthly_at > first_observed_at
+      )::integer as monthly_hits
+    from classified
+  ), board as (
+    select
+      exposures.*,
+      milestones.first_official_daily_at,
+      milestones.first_official_daily_rank,
+      milestones.first_official_weekly_at,
+      milestones.first_official_monthly_at,
+      coalesce(milestones.first_official_daily_at > exposures.first_board_at, false) as shown_first
+    from radar.discovery_board_exposures exposures
+    left join radar.repository_discovery_milestones milestones using (full_name_key)
+  ), board_recent as (
+    select *
+    from board
+    where shown_first
+    order by first_official_daily_at desc, full_name_key
+    limit 5
+  ), board_summary as (
+    select
+      min(first_board_at) as evidence_started_at,
+      count(*) filter (where shown_first)::integer as verified_count,
+      percentile_cont(0.5) within group (
+        order by extract(epoch from (first_official_daily_at - first_board_at)) / 3600
+      ) filter (where shown_first) as median_lead_hours,
+      count(*) filter (where first_official_weekly_at > first_board_at)::integer as weekly_hits,
+      count(*) filter (where first_official_monthly_at > first_board_at)::integer as monthly_hits,
+      count(*) filter (where top10_hit_7d is not null)::integer as top10_eligible,
+      count(*) filter (where top10_hit_7d)::integer as top10_hits,
+      count(*) filter (where board_hit_7d is not null)::integer as board_eligible,
+      count(*) filter (where board_hit_7d)::integer as board_hits
+    from board
+  )
+  select jsonb_build_object(
+    'schema_version', '1.0',
+    'evidence_started_at', summary.evidence_started_at,
+    'generated_at', latest_captured_at,
+    'verified_count', summary.verified_count,
+    'median_lead_hours', summary.median_lead_hours,
+    'conversion_7d', jsonb_build_object(
+      'converted', conversions.converted_7d,
+      'eligible', conversions.eligible_7d,
+      'rate', case when conversions.eligible_7d = 0 then null
+        else conversions.converted_7d::numeric / conversions.eligible_7d end
+    ),
+    'conversion_14d', jsonb_build_object(
+      'converted', conversions.converted_14d,
+      'eligible', conversions.eligible_14d,
+      'rate', case when conversions.eligible_14d = 0 then null
+        else conversions.converted_14d::numeric / conversions.eligible_14d end
+    ),
+    'period_hits', jsonb_build_object(
+      'daily', summary.daily_hits,
+      'weekly', summary.weekly_hits,
+      'monthly', summary.monthly_hits
+    ),
+    'recent_hits', coalesce((
+      select jsonb_agg(jsonb_build_object(
+        'full_name', recent_hits.full_name,
+        'first_observed_at', recent_hits.first_observed_at,
+        'first_trending_at', recent_hits.first_official_daily_at,
+        'first_trending_rank', recent_hits.first_official_daily_rank,
+        'lead_hours', extract(epoch from (
+          recent_hits.first_official_daily_at - recent_hits.first_observed_at
+        )) / 3600,
+        'sources', to_jsonb(recent_hits.first_observation_sources),
+        'coverage', 'complete'
+      ) order by recent_hits.first_official_daily_at desc, recent_hits.full_name_key)
+      from recent_hits
+    ), '[]'::jsonb),
+    'board', jsonb_build_object(
+      'hit_rule', jsonb_build_object('window_days', 7, 'min_star_gain', 500),
+      'evidence_started_at', board_summary.evidence_started_at,
+      'verified_count', board_summary.verified_count,
+      'median_lead_hours', board_summary.median_lead_hours,
+      'period_hits', jsonb_build_object(
+        'daily', board_summary.verified_count,
+        'weekly', board_summary.weekly_hits,
+        'monthly', board_summary.monthly_hits
+      ),
+      'hit_rate_7d', jsonb_build_object(
+        'top10', jsonb_build_object(
+          'hits', board_summary.top10_hits,
+          'eligible', board_summary.top10_eligible,
+          'rate', case when board_summary.top10_eligible = 0 then null
+            else board_summary.top10_hits::numeric / board_summary.top10_eligible end
+        ),
+        'board', jsonb_build_object(
+          'hits', board_summary.board_hits,
+          'eligible', board_summary.board_eligible,
+          'rate', case when board_summary.board_eligible = 0 then null
+            else board_summary.board_hits::numeric / board_summary.board_eligible end
+        )
+      ),
+      'recent_hits', coalesce((
+        select jsonb_agg(jsonb_build_object(
+          'full_name', board_recent.full_name,
+          'first_shown_at', board_recent.first_board_at,
+          'first_shown_rank', board_recent.first_board_rank,
+          'first_trending_at', board_recent.first_official_daily_at,
+          'first_trending_rank', board_recent.first_official_daily_rank,
+          'lead_hours', extract(epoch from (
+            board_recent.first_official_daily_at - board_recent.first_board_at
+          )) / 3600
+        ) order by board_recent.first_official_daily_at desc, board_recent.full_name_key)
+        from board_recent
+      ), '[]'::jsonb)
+    )
+  ) into result
+  from summary
+  cross join conversions
+  cross join board_summary;
+
+  return result;
+end;
+$$;
+revoke execute on function radar.compute_track_record() from public;
+grant execute on function radar.compute_track_record() to collector;
+
+-- 수집 실행 id가 곧 그 실행이 만든 스냅샷 id다(api.complete_collection).
+create or replace function radar.update_track_record_summary()
+returns trigger language plpgsql set search_path = pg_catalog, radar as $$
+begin
+  perform radar.record_board_exposures(new.id);
+  perform radar.settle_board_outcomes((select max(captured_at) from radar.snapshots));
+  insert into radar.track_record_summary(id, payload) values (true, radar.compute_track_record())
+  on conflict (id) do update set payload = excluded.payload;
+  return null;
+end;
+$$;
+revoke execute on function radar.update_track_record_summary() from public;
+
+do $$
+declare
+  snapshot record;
+begin
+  for snapshot in select id from radar.snapshots order by captured_at loop
+    perform radar.record_board_exposures(snapshot.id);
+  end loop;
+end;
+$$;
+select radar.settle_board_outcomes(max(captured_at)) from radar.snapshots having max(captured_at) is not null;
+
+insert into radar.track_record_summary(id, payload)
+select true, radar.compute_track_record() where exists (select 1 from radar.snapshots)
+on conflict (id) do update set payload = excluded.payload;
+
+notify pgrst, 'reload schema';
+commit;
diff --git a/deploy/oracle/tests/regression-024.mjs b/deploy/oracle/tests/regression-024.mjs
new file mode 100644
index 0000000..4c52326
--- /dev/null
+++ b/deploy/oracle/tests/regression-024.mjs
@@ -0,0 +1,65 @@
+import assert from 'node:assert/strict';
+import { readFileSync } from 'node:fs';
+
+const DAY = 24 * 60 * 60 * 1000;
+
+export default async function ({ sql, json, check, repository }) {
+  const now = Date.now();
+  const at = days => new Date(now - days * DAY).toISOString();
+  let runIndex = 0;
+  function collect(capturedAt, rows) {
+    runIndex += 1;
+    const id = `24000000-0000-4000-8000-${String(runIndex).padStart(12, '0')}`;
+    sql(`set role collector;
+      select api.start_collection('${id}', '${capturedAt}');
+      select api.complete_collection('${id}', '${capturedAt}', 'fixture',
+        $payload$${JSON.stringify(rows)}$payload$::jsonb);`);
+  }
+  const board = (full_name, score, stars, extra = {}) => repository({
+    full_name, stars, trend_intelligence: { breakout: { score } }, ...extra,
+  });
+  const trending = (full_name, stars) => repository({
+    full_name, stars, observation_sources: ['official_daily'],
+    official_ranks: { daily: 3, weekly: null, monthly: null },
+  });
+
+  await check('024 records first board exposure and settles 7-day hits once mature', () => {
+    collect(at(10), [board('a/star', 90, 100), board('b/trend', 80, 100), board('c/miss', 70, 100)]
+      .map((row, index) => ({ ...row, rank: index + 1 })));
+    collect(at(9), [{ ...repository({ full_name: 'a/star', stars: 700 }), rank: 1 }]);
+    collect(at(3), [{ ...trending('b/trend', 150), rank: 1 }]);
+    collect(at(0), [{ ...board('d/late', 95, 50), rank: 1 }]);
+
+    const exposures = json(`select jsonb_object_agg(full_name, jsonb_build_object(
+        'rank', first_board_rank, 'top10', first_top10_at is not null, 'hit', board_hit_7d, 'top10_hit', top10_hit_7d))
+      from radar.discovery_board_exposures`);
+    assert.deepEqual(exposures, {
+      'a/star': { rank: 1, top10: true, hit: true, top10_hit: true },
+      'b/trend': { rank: 2, top10: true, hit: true, top10_hit: true },
+      'c/miss': { rank: 3, top10: true, hit: false, top10_hit: false },
+      'd/late': { rank: 1, top10: true, hit: null, top10_hit: null },
+    });
+
+    const boardRecord = json('set role web_anon; select api.discovery_track_record()').board;
+    assert.deepEqual(boardRecord.hit_rule, { window_days: 7, min_star_gain: 500 });
+    assert.equal(boardRecord.verified_count, 1);
+    assert.equal(Math.round(boardRecord.median_lead_hours), 168);
+    assert.deepEqual(boardRecord.hit_rate_7d.board, { hits: 2, eligible: 3, rate: 2 / 3 });
+    assert.deepEqual(boardRecord.hit_rate_7d.top10, { hits: 2, eligible: 3, rate: 2 / 3 });
+    assert.equal(boardRecord.recent_hits.length, 1);
+    assert.equal(boardRecord.recent_hits[0].full_name, 'b/trend');
+    assert.equal(boardRecord.recent_hits[0].first_shown_rank, 2);
+    assert.equal(boardRecord.recent_hits[0].first_trending_rank, 3);
+  });
+
+  await check('024 backfill is idempotent and keeps the legacy track record fields', () => {
+    const before = json('set role web_anon; select api.discovery_track_record()');
+    sql(readFileSync(new URL('../db/migrations/024_board_track_record.sql', import.meta.url), 'utf8'));
+    const after = json('set role web_anon; select api.discovery_track_record()');
+    assert.deepEqual(after, before);
+    assert.equal(after.schema_version, '1.0');
+    for (const field of ['verified_count', 'median_lead_hours', 'conversion_7d', 'conversion_14d', 'period_hits', 'recent_hits']) {
+      assert.ok(field in after, field);
+    }
+  });
+}
