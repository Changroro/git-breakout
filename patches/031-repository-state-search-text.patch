diff --git a/deploy/oracle/tests/regression-031.mjs b/deploy/oracle/tests/regression-031.mjs
new file mode 100644
index 0000000..6f474f5
--- /dev/null
+++ b/deploy/oracle/tests/regression-031.mjs
@@ -0,0 +1,80 @@
+import assert from 'node:assert/strict';
+import { readFileSync } from 'node:fs';
+
+const source = name => readFileSync(new URL(`../db/migrations/${name}.sql`, import.meta.url), 'utf8');
+const DAY = 86400000;
+// present(day), trending(day) and payload fields per repository; the last snapshot is day 9.
+const repositories = {
+  'alpha/vector': { present: () => true, trending: day => day % 3 === 0, description: 'Vector database', language: 'Rust', topics: ['search', 'database'] },
+  'beta/plain': { present: day => day < 6, trending: () => false, description: null, language: null, topics: [] },
+  'gamma/mcp': { present: day => day < 8, trending: day => day >= 2 && day < 5, description: 'MCP server toolkit', language: 'TypeScript', topics: ['mcp', 'agents'] },
+  'Delta/Project': { present: day => day < 4, trending: day => day === 1 || day === 3, description: 'Agents for search', language: 'Python', topics: ['Agents'] },
+  'zeta/untagged': { present: day => day === 2 || day === 5, trending: day => day === 5, description: 'No topics key', language: 'Go', topics: undefined },
+  'epsilon/fresh': { present: day => day === 9, trending: () => true, description: 'Fresh arrival', language: 'Rust', topics: ['database'] },
+};
+const stateColumns = `full_name_key, full_name, first_seen_at, first_observed_stars, first_observation_was_trending,
+  official_trending_episode_count, latest_snapshot_id, latest_captured_at, latest_rank, latest_stars, latest_pushed_at, latest_is_trending`;
+
+export default async function ({ sql, json, check, repository }) {
+  const states = table => json(`select coalesce(jsonb_agg(to_jsonb(s) order by full_name_key), '[]') from (select ${stateColumns} from radar.${table}) s`);
+  const pages = [[1, 100, null], [1, 2, null], [2, 2, null], [9, 2, null], [1, 100, 'rust'], [1, 100, 'MCP  agents'],
+    [1, 100, 'delta'], [1, 100, 'toolkit typescript'], [1, 100, 'agents'], [1, 1, 'project'], [1, 100, 'no-such-repository']];
+  const archive = name => pages.map(([page, size, query]) =>
+    json(`set role web_anon; select ${name}(${page}, ${size}, ${query === null ? 'null' : `'${query}'`})`));
+
+  await check('031 archive pages and repository state match the 013 payload copy exactly', () => {
+    for (let day = 0; day < 10; day += 1) {
+      const id = `31000000-0000-4000-8000-${String(day + 1).padStart(12, '0')}`;
+      const capturedAt = new Date(Date.UTC(2026, 8, 1) + day * DAY).toISOString();
+      const rows = Object.entries(repositories).filter(([, value]) => value.present(day)).map(([name, value], index) => {
+        // The repository keeps its key while the spelling of its name changes.
+        const fullName = name === 'Delta/Project' && day >= 2 ? 'delta/project' : name;
+        const payload = repository({ full_name: fullName, rank: index + 1, stars: 100 + day * (index + 1),
+          description: value.description, language: value.language, topics: value.topics,
+          pushed_at: day % 2 === 0 ? capturedAt : null,
+          official_ranks: { daily: value.trending(day) ? index + 1 : null, weekly: null, monthly: null } });
+        return `('${id}','${capturedAt}','${fullName}',${index + 1},${100 + day * (index + 1)},$p$${JSON.stringify(payload)}$p$::jsonb)`;
+      });
+      sql(`begin; set local role collector;
+        insert into radar.collector_runs(id,started_at,finished_at,status) values('${id}','${capturedAt}','${capturedAt}','completed');
+        insert into radar.snapshots(id,captured_at,source,repository_count) values('${id}','${capturedAt}','search-text-test',${rows.length});
+        insert into radar.snapshot_repositories(snapshot_id,captured_at,full_name,rank,stars,payload_json) values ${rows.join(',')}; commit;`);
+    }
+
+    // The 013 backfill computes every state row, payload copy included, from the full history.
+    const backfill = source('013_repository_state').match(/with observations as \([\s\S]*?from ordered group by full_name_key;/)[0];
+    const original = source('013_repository_state').match(/create or replace function api\.archive_page\([\s\S]*?\n\$\$;/)[0];
+    sql(`create table radar.repository_state_reference as select ${stateColumns}, null::jsonb as payload_json
+        from radar.repository_state where false;
+      insert into radar.repository_state_reference ${backfill}
+      grant select on radar.repository_state_reference to web_anon;
+      ${original.replaceAll('radar.repository_state', 'radar.repository_state_reference')
+        .replace('api.archive_page(', 'radar.archive_page_reference(')}
+      grant execute on function radar.archive_page_reference(integer, integer, text) to web_anon;`);
+
+    assert.deepEqual(states('repository_state'), states('repository_state_reference'));
+    assert.equal(sql(`select count(*) from radar.repository_state s join radar.repository_state_reference r using(full_name_key)
+      where s.search_text = radar.repository_search_text(r.full_name, r.payload_json)`), '6');
+    assert.equal(sql(`select search_text from radar.repository_state where full_name_key = 'delta/project'`),
+      'delta/project agents for search python agents');
+    assert.equal(sql(`select search_text from radar.repository_state where full_name_key = 'beta/plain'`), 'beta/plain');
+
+    const current = archive('api.archive_page');
+    assert.deepEqual(current, archive('radar.archive_page_reference'));
+    assert.equal(current[0].archive_count, 4);
+    assert.deepEqual(current[5].repositories.map(row => row.full_name), ['gamma/mcp']);
+    assert.deepEqual(current[8].repositories.map(row => row.full_name), ['gamma/mcp', 'delta/project']);
+    assert.equal(current[10].matching_count, 0);
+  });
+
+  await check('031 reapplies cleanly and keeps collected repositories on neighbouring pages', () => {
+    const [before, pagesBefore] = [states('repository_state'), archive('api.archive_page')];
+    sql(source('031_repository_state_search_text'));
+    assert.deepEqual(states('repository_state'), before);
+    assert.deepEqual(archive('api.archive_page'), pagesBefore);
+    assert.equal(sql(`select string_agg(full_name_key, ',' order by ctid) from radar.repository_state`),
+      sql(`select string_agg(full_name_key, ',' order by latest_captured_at desc, full_name_key) from radar.repository_state`));
+    assert.equal(sql(`select count(*) from information_schema.columns
+      where table_schema = 'radar' and table_name = 'repository_state' and column_name = 'payload_json'`), '0');
+  });
+}
