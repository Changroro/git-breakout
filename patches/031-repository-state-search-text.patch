diff --git a/deploy/oracle/db/migrations/031_repository_state_search_text.sql b/deploy/oracle/db/migrations/031_repository_state_search_text.sql
new file mode 100644
index 0000000..6b57c51
--- /dev/null
+++ b/deploy/oracle/db/migrations/031_repository_state_search_text.sql
@@ -0,0 +1,199 @@
+begin;
+
+set local lock_timeout = '5s';
+-- Block collector inserts until the column and the trigger that writes it change together.
+lock table radar.snapshot_repositories in share row exclusive mode;
+
+-- The text archive search matches against; kept in repository_state so a search does not read every payload.
+create or replace function radar.repository_search_text(p_full_name text, p_payload jsonb)
+returns text language sql stable set search_path = pg_catalog as $$
+  select lower(concat_ws(' ', p_full_name, p_payload->>'description', p_payload->>'language',
+    (select string_agg(topic.value, ' ') from jsonb_array_elements_text(p_payload->'topics') topic(value))));
+$$;
+revoke execute on function radar.repository_search_text(text, jsonb) from public;
+grant execute on function radar.repository_search_text(text, jsonb) to collector;
+
+-- repository_state kept a copy of each latest payload; the snapshot row it points at already holds it.
+do $$
+begin
+  if exists(select 1 from information_schema.columns
+      where table_schema = 'radar' and table_name = 'repository_state' and column_name = 'payload_json') then
+    alter table radar.repository_state alter column payload_json type text
+      using radar.repository_search_text(full_name, payload_json);
+    alter table radar.repository_state rename column payload_json to search_text;
+  end if;
+end;
+$$;
+-- Collected repositories are rewritten every collection; storing them together with room for the next version keeps those writes on few pages.
+alter table radar.repository_state set (fillfactor = 50);
+cluster radar.repository_state using repository_state_observed_idx;
+
+create or replace function radar.update_repository_state()
+returns trigger language plpgsql set search_path=pg_catalog,radar as $$
+begin
+  if exists(select 1 from new_rows n join radar.repository_state s using(full_name_key)
+      where n.captured_at<=s.latest_captured_at)
+    or exists(select 1 from new_rows group by full_name_key having count(*)>1) then
+    raise exception 'Repository state requires one chronological observation per repository per statement';
+  end if;
+  insert into radar.repository_state
+  select full_name_key, full_name, captured_at, stars, identity_is_trending, case when identity_is_trending then 1 else 0 end,
+    snapshot_id, captured_at, rank, stars, identity_pushed_at, identity_is_trending,
+    radar.repository_search_text(full_name, payload_json)
+  from new_rows
+  on conflict(full_name_key) do update set
+    full_name=excluded.full_name,
+    official_trending_episode_count=repository_state.official_trending_episode_count+
+      case when excluded.latest_is_trending and not repository_state.latest_is_trending then 1 else 0 end,
+    latest_snapshot_id=excluded.latest_snapshot_id, latest_captured_at=excluded.latest_captured_at,
+    latest_rank=excluded.latest_rank, latest_stars=excluded.latest_stars,
+    latest_pushed_at=excluded.latest_pushed_at, latest_is_trending=excluded.latest_is_trending,
+    search_text=excluded.search_text;
+  return null;
+end;
+$$;
+
+create or replace function api.archive_page(
+  p_page integer,
+  p_page_size integer,
+  p_query text
+)
+returns jsonb
+language plpgsql
+stable
+set search_path = pg_catalog, radar
+as $$
+declare
+  latest_snapshot radar.snapshots%rowtype;
+  normalized_query text;
+  archive_count integer;
+  matching_count integer;
+  normalized_page integer;
+  expected_page_count integer;
+  repositories jsonb;
+begin
+  if p_page < 1 then
+    raise exception 'Archive page must be positive';
+  end if;
+  if p_page_size not between 1 and 100 then
+    raise exception 'Archive page size must be between 1 and 100';
+  end if;
+  if p_query is not null and length(p_query) > 200 then
+    raise exception 'Archive query must contain at most 200 characters';
+  end if;
+
+  select * into latest_snapshot
+  from radar.snapshots
+  order by captured_at desc
+  limit 1;
+  if not found then
+    raise exception 'No completed ranking snapshots are available';
+  end if;
+
+  normalized_query := nullif(lower(btrim(p_query)), '');
+
+  with last_rows as (
+    select latest_snapshot_id as snapshot_id,latest_captured_at as captured_at,
+      full_name_key,full_name,latest_rank as rank,search_text from radar.repository_state
+  ), archived as (
+    select last_rows.*
+    from last_rows
+    where last_rows.snapshot_id <> latest_snapshot.id
+  )
+  select count(*) into archive_count from archived;
+
+  with last_rows as (
+    select latest_snapshot_id as snapshot_id,latest_captured_at as captured_at,
+      full_name_key,full_name,latest_rank as rank,search_text from radar.repository_state
+  ), archived as (
+    select
+      last_rows.*,
+      last_rows.search_text as searchable_text
+    from last_rows
+    where last_rows.snapshot_id <> latest_snapshot.id
+  ), matching as (
+    select archived.*
+    from archived
+    where normalized_query is null or not exists (
+      select 1
+      from regexp_split_to_table(normalized_query, '\s+') term(value)
+      where archived.searchable_text not like '%' || term.value || '%'
+    )
+  )
+  select count(*) into matching_count from matching;
+
+  normalized_page := least(
+    p_page,
+    greatest(1, ceil(matching_count::numeric / p_page_size)::integer)
+  );
+  expected_page_count := least(
+    p_page_size,
+    greatest(0, matching_count - (normalized_page - 1) * p_page_size)
+  );
+
+  with last_rows as (
+    select latest_snapshot_id as snapshot_id,latest_captured_at as captured_at,
+      full_name_key,full_name,latest_rank as rank,search_text from radar.repository_state
+  ), archived as (
+    select
+      last_rows.*,
+      last_rows.search_text as searchable_text
+    from last_rows
+    where last_rows.snapshot_id <> latest_snapshot.id
+  ), matching as (
+    select archived.*
+    from archived
+    where normalized_query is null or not exists (
+      select 1
+      from regexp_split_to_table(normalized_query, '\s+') term(value)
+      where archived.searchable_text not like '%' || term.value || '%'
+    )
+  ), ranked as (
+    select
+      matching.*,
+      row_number() over (
+        order by matching.captured_at desc, matching.full_name_key
+      ) as position
+    from matching
+  ), selected as (
+    select *
+    from ranked
+    where position between
+      (normalized_page - 1) * p_page_size + 1
+      and normalized_page * p_page_size
+  )
+  select coalesce(jsonb_agg(
+    observed.payload_json || jsonb_build_object(
+      'rank', selected.rank,
+      'last_snapshot_id', selected.snapshot_id,
+      'last_observed_at', selected.captured_at
+    ) order by selected.position
+  ), '[]'::jsonb)
+  into repositories
+  from selected
+  -- The payload lives only in the snapshot row that repository_state points at.
+  join radar.snapshot_repositories observed
+    on observed.snapshot_id = selected.snapshot_id and observed.full_name_key = selected.full_name_key;
+
+  if jsonb_array_length(repositories) <> expected_page_count then
+    raise exception 'Archive page contains an unexpected repository count';
+  end if;
+
+  return jsonb_build_object(
+    'schema_version', '1.0',
+    'latest_snapshot_id', latest_snapshot.id,
+    'latest_captured_at', latest_snapshot.captured_at,
+    'archive_count', archive_count,
+    'matching_count', matching_count,
+    'page', normalized_page,
+    'page_size', p_page_size,
+    'repositories', repositories
+  );
+end;
+$$;
+
+revoke execute on function api.archive_page(integer, integer, text) from public;
+grant execute on function api.archive_page(integer, integer, text) to web_anon, collector;
+
+notify pgrst, 'reload schema';
+commit;
