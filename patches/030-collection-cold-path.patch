diff --git a/deploy/oracle/tests/regression-030.mjs b/deploy/oracle/tests/regression-030.mjs
new file mode 100644
index 0000000..70837d5
--- /dev/null
+++ b/deploy/oracle/tests/regression-030.mjs
@@ -0,0 +1,175 @@
+import assert from 'node:assert/strict';
+import { readFileSync } from 'node:fs';
+
+const source = name => readFileSync(new URL(`../db/migrations/${name}.sql`, import.meta.url), 'utf8');
+
+export default async function ({ sql, json, check, repository }) {
+  let sequence = 0;
+  function save(name, repositoryId, trending, day, aliases = [name]) {
+    sequence += 1;
+    const id = `30000000-0000-4000-8000-${String(sequence).padStart(12, '0')}`;
+    const capturedAt = new Date(Date.UTC(2026, 7, 1) + day * 86400000 + sequence * 1000).toISOString();
+    const value = repository({ full_name: name, pushed_at: capturedAt, stars: 1000 + sequence,
+      official_ranks: { daily: trending ? 1 : null, weekly: null, monthly: null } });
+    if (repositoryId !== null) Object.assign(value, { repository_id: repositoryId, repository_aliases: aliases });
+    sql(`begin; set local role collector;
+      insert into radar.collector_runs(id,started_at,finished_at,status) values('${id}','${capturedAt}','${capturedAt}','completed');
+      insert into radar.snapshots(id,captured_at,source,repository_count) values('${id}','${capturedAt}','identity-summary-test',1);
+      insert into radar.snapshot_repositories(snapshot_id,captured_at,full_name,rank,stars,payload_json)
+      values('${id}','${capturedAt}','${name}',1,${1000 + sequence},$payload$${JSON.stringify(value)}$payload$::jsonb); commit;`);
+    return id;
+  }
+  const proof = (repository_id, full_name, requested = []) => ({ repository_id, full_name, requested_names: [full_name, ...requested] });
+  // Summaries describe these; the rest need the legacy rows themselves.
+  const summarized = [proof('R_boundary', 'boundary/new', ['boundary/old']), proof('R_quiet', 'quiet/project'),
+    proof('R_verified', 'verified/project'), proof('R_new', 'new/project'), proof('R_reuse', 'reuse/project'),
+    proof('R_absent', 'absent/project')];
+  const rowBased = [proof('R_short', 'short/project'), proof('R_names', 'names/new', ['names/old']),
+    proof('R_legacy_only', 'legacy-only/project'), proof('R_interleaved', 'interleaved/project'),
+    proof('R_recent', 'recent/project')];
+  const call = (name, proofs) => `select ${name}($proofs$${JSON.stringify(proofs)}$proofs$::jsonb)`;
+  const context = (proofs = [...summarized, ...rowBased]) => json(`set role collector; ${call('api.repository_identity_context', proofs)}`);
+  const reference = (proofs = [...summarized, ...rowBased]) =>
+    json(`set role collector; ${call('radar.repository_identity_context_reference', proofs)}`);
+  const table = name => json(`select coalesce(jsonb_agg(to_jsonb(t) order by to_jsonb(t)::text), '[]') from radar.${name} t`);
+  const withoutRows = proofs => sql(`begin;
+    create or replace function radar.repository_identity_row_context(p_repositories jsonb) returns setof jsonb
+    language plpgsql strict as $$ begin raise exception 'Row context used'; end; $$;
+    ${call('api.repository_identity_context', proofs)}; rollback;`);
+  const byId = (value, id) => value.repositories.find(row => row.repository_id === id);
+  const verifiedDays = (name, id, from, count, aliases) => {
+    for (let day = from; day < from + count; day += 1) save(name, id, day % 5 === 0, day, aliases);
+  };
+
+  await check('030 summarized identity context matches the 026 row-based context exactly', () => {
+    const original = source('026_identity_context_state').match(/create or replace function api\.repository_identity_context[\s\S]*?\n\$\$;/)[0];
+    sql(`${original.replace('api.repository_identity_context(', 'radar.repository_identity_context_reference(')}
+      grant execute on function radar.repository_identity_context_reference(jsonb) to collector;`);
+
+    [false, true, false, true].forEach((trending, day) => save('boundary/old', null, trending, day));
+    verifiedDays('boundary/new', 'R_boundary', 5, 22, ['boundary/old', 'boundary/new']);
+    [true, false].forEach((trending, day) => save('quiet/project', null, trending, day));
+    verifiedDays('quiet/project', 'R_quiet', 6, 20);
+    verifiedDays('verified/project', 'R_verified', 0, 30);
+    verifiedDays('new/project', 'R_new', 38, 3);
+    save('reuse/project', null, true, 0);
+    save('reuse/project', 'R_reused_name', true, 1);
+    verifiedDays('reuse/project', 'R_reuse', 10, 21);
+    [true, true].forEach((trending, day) => save('short/project', null, trending, day));
+    verifiedDays('short/project', 'R_short', 5, 19);
+    save('names/old', null, true, 0);
+    save('names/new', null, true, 1);
+    verifiedDays('names/new', 'R_names', 5, 21, ['names/old', 'names/new']);
+    [false, true, true].forEach((trending, day) => save('legacy-only/project', null, trending, day));
+    verifiedDays('interleaved/project', 'R_interleaved', 0, 10);
+    save('interleaved/project', null, false, 10);
+    verifiedDays('interleaved/project', 'R_interleaved', 11, 12);
+    // Legacy rows inside the growth window still decide the comparison point.
+    [30, 37, 39].forEach(day => save('recent/project', null, day === 39, day));
+    for (let point = 0; point < 21; point += 1) save('recent/project', 'R_recent', point % 2 === 0, 40);
+
+    const after = context();
+    assert.deepEqual(after, reference());
+    assert.deepEqual(after.repositories.map(row => row.repository_id).sort(),
+      [...summarized, ...rowBased].map(row => row.repository_id).filter(id => id !== 'R_absent').sort());
+    assert.equal(byId(after, 'R_boundary').identity_status, 'legacy_unverified');
+    // Legacy entries on days 1 and 3; day 5 continues the day-3 entry, so the verified days 10 to 25 add four.
+    assert.equal(byId(after, 'R_boundary').official_trending_episode_count, 6);
+    assert.equal(byId(after, 'R_boundary').observations.length, 20);
+    assert.equal(byId(after, 'R_reuse').identity_status, 'verified');
+    assert.ok(byId(after, 'R_recent').growth_comparison_captured_at);
+
+    assert.deepEqual(json(`begin; set local role collector; ${call('api.repository_identity_context', summarized)}; rollback;`),
+      reference(summarized));
+    withoutRows(summarized);
+    for (const row of rowBased) assert.throws(() => withoutRows([row]), /Row context used/);
+  });
+
+  await check('030 summaries follow later legacy writes and match a full rebuild', () => {
+    const rebuilt = name => {
+      const stored = table(name);
+      sql(`select radar.rebuild_${name}(null)`);
+      assert.deepEqual(table(name), stored);
+    };
+    const compare = () => {
+      assert.deepEqual(context(), reference());
+      rebuilt('repository_legacy_summary');
+      rebuilt('repository_identity_state');
+    };
+    compare();
+    // A legacy row after the verified rows moves the repository to the row-based path.
+    save('quiet/project', null, true, 50);
+    assert.throws(() => withoutRows([proof('R_quiet', 'quiet/project')]), /Row context used/);
+    compare();
+    sql(`update radar.snapshot_repositories set payload_json = jsonb_set(payload_json, '{official_ranks,daily}', 'null')
+      where full_name_key = 'boundary/old' and identity_is_trending`);
+    assert.equal(byId(context(), 'R_boundary').official_trending_episode_count, 5);
+    compare();
+    sql(`delete from radar.snapshot_repositories where full_name_key = 'quiet/project' and not payload_json ? 'repository_id'
+      and captured_at > '2026-09-01'`);
+    withoutRows([proof('R_quiet', 'quiet/project')]);
+    compare();
+    // An observation earlier than the stored first one rebuilds the first-observation columns.
+    save('verified/early', 'R_verified', false, -1, ['verified/early', 'verified/project']);
+    assert.equal(byId(context(), 'R_verified').first_observation_was_trending, false);
+    compare();
+
+    const before = context();
+    const [summaries, states] = [table('repository_legacy_summary'), table('repository_identity_state')];
+    sql(source('030_collection_cold_path'));
+    assert.deepEqual(context(), before);
+    assert.deepEqual(table('repository_legacy_summary'), summaries);
+    assert.deepEqual(table('repository_identity_state'), states);
+  });
+
+  await check('030 completion stores the 017 milestones without rewriting unchanged rows', () => {
+    const original = source('017_collection_atomicity').match(/create or replace function api\.complete_collection\([\s\S]*?\n\$\$;/)[0];
+    sql(original.replace('api.complete_collection(', 'radar.complete_collection_reference('));
+    const stamp = hour => new Date(Date.UTC(2026, 10, 1) + hour * 3600000).toISOString();
+    const entry = (full_name, rank, official = {}) => repository({ full_name, rank, repository_id: `M_${full_name.toLowerCase()}`,
+      repository_aliases: [full_name], official_ranks: { daily: null, weekly: null, monthly: null, ...official },
+      observation_sources: ['github_search_created', ...Object.keys(official).map(period => `official_${period}`)] });
+    const collections = [
+      [0, [entry('alpha/project', 1, { daily: 3 }), entry('beta/project', 2), entry('gamma/project', 3, { weekly: 5 })]],
+      [2, [entry('alpha/project', 1), entry('beta/project', 2, { daily: 1 }), entry('Gamma/Project', 3), entry('delta/project', 4)]],
+      [4, [entry('alpha/project', 1), entry('beta/project', 2, { daily: 1 }), entry('Gamma/Project', 3), entry('delta/project', 4)]],
+      // The long gap also runs the coverage-gap update.
+      [12, [entry('alpha/project', 1, { monthly: 2 }), entry('beta/project', 2), entry('epsilon/project', 3, { monthly: 1 })]],
+    ];
+    const locations = `select full_name_key, ctid::text as location from radar.repository_discovery_milestones`;
+    const stored = name => json(`begin; ${collections.map(([hour, repositories], index) => `
+      ${index === 2 ? `create temp table before_unchanged as ${locations};` : ''}
+      do $run$ begin
+        perform api.start_collection('30100000-0000-4000-8000-00000000000${index}', '${stamp(hour)}');
+        perform ${name}('30100000-0000-4000-8000-00000000000${index}', '${stamp(hour)}', 'milestone-test',
+          $repositories$${JSON.stringify(repositories)}$repositories$::jsonb);
+      end $run$;
+      ${index === 2 ? `create temp table rewritten as select count(*) as row_count from (${locations}) m
+        join before_unchanged b using(full_name_key) where m.location <> b.location;` : ''}`).join('')}
+      select jsonb_build_object('rewritten', (select row_count from rewritten), 'milestones',
+        (select jsonb_agg(to_jsonb(m) order by full_name_key) from radar.repository_discovery_milestones m)); rollback;`);
+    const [before, after] = [stored('radar.complete_collection_reference'), stored('api.complete_collection')];
+    assert.deepEqual(after.milestones, before.milestones);
+    const milestone = name => after.milestones.find(row => row.full_name_key === name);
+    assert.equal(milestone('gamma/project').full_name, 'Gamma/Project');
+    assert.equal(milestone('beta/project').first_official_daily_rank, 1);
+    assert.equal(milestone('alpha/project').first_official_monthly_rank, 2);
+    assert.equal(milestone('delta/project').coverage_gap, true);
+    assert.deepEqual([before.rewritten, after.rewritten], [4, 0]);
+  });
+
+  await check('030 context fails loudly when stored first observations are missing', () => {
+    sql(`update radar.repository_identity_state set first_captured_at = null where repository_id = 'R_verified'`);
+    assert.throws(() => context(), /Repository identity state is out of date/);
+    sql(`select radar.rebuild_repository_identity_state(array['R_verified'])`);
+    assert.deepEqual(context(), reference());
+    // A row without recent observations is rebuilt, not extended, by its next observation.
+    sql(`update radar.repository_identity_state set recent_captured_at = null, recent_stars = null where repository_id = 'R_new'`);
+    assert.throws(() => context(), /Repository identity state is out of date/);
+    save('new/project', 'R_new', true, 60);
+    assert.deepEqual(context(), reference());
+    const stored = table('repository_identity_state');
+    sql('select radar.rebuild_repository_identity_state(null)');
+    assert.deepEqual(table('repository_identity_state'), stored);
+  });
+}
