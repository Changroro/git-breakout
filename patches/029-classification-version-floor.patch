diff --git a/deploy/oracle/db/migrations/029_classification_version_floor.sql b/deploy/oracle/db/migrations/029_classification_version_floor.sql
new file mode 100644
index 0000000..71c268e
--- /dev/null
+++ b/deploy/oracle/db/migrations/029_classification_version_floor.sql
@@ -0,0 +1,29 @@
+begin;
+
+-- Every trend-intelligence version from v7 on classifies discovery candidates, so later versions stay counted.
+create or replace function radar.refresh_snapshot_summary(p_snapshot_id uuid)
+returns void language sql set search_path=pg_catalog,radar as $$
+  insert into radar.snapshot_summary
+  with candidates as materialized (
+    select full_name_key,payload_json from radar.snapshot_repositories where snapshot_id=p_snapshot_id
+  ), languages as (
+    select lower(btrim(payload_json->>'language')) as value,min(btrim(payload_json->>'language')) as label,count(*)::integer as count
+    from candidates where nullif(btrim(payload_json->>'language'),'') is not null group by lower(btrim(payload_json->>'language'))
+  ), topics as (
+    select lower(btrim(t.value)) as value,min(btrim(t.value)) as label,count(distinct full_name_key)::integer as count
+    from candidates cross join lateral jsonb_array_elements_text(payload_json->'topics') t(value)
+    where btrim(t.value)<>'' group by lower(btrim(t.value))
+  )
+  select p_snapshot_id,
+    coalesce((select jsonb_agg(to_jsonb(l) order by count desc,label) from languages l),'[]'::jsonb),
+    coalesce((select jsonb_agg(to_jsonb(t) order by count desc,label) from topics t),'[]'::jsonb),
+    exists(select 1 from candidates where payload_json ? 'trend_intelligence'),
+    exists(select 1 from candidates where substring(payload_json #>> '{trend_intelligence,score_version}' from '^trend-intelligence-v([0-9]{1,9})-shadow$')::integer >= 7)
+  on conflict(snapshot_id) do update set languages=excluded.languages,topics=excluded.topics,
+    intelligence_available=excluded.intelligence_available,classification_available=excluded.classification_available;
+$$;
+revoke execute on function radar.refresh_snapshot_summary(uuid) from public;
+grant execute on function radar.refresh_snapshot_summary(uuid) to collector;
+
+notify pgrst, 'reload schema';
+commit;
