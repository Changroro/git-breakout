diff --git a/deploy/oracle/tests/regression-029.mjs b/deploy/oracle/tests/regression-029.mjs
new file mode 100644
index 0000000..3ccbd98
--- /dev/null
+++ b/deploy/oracle/tests/regression-029.mjs
@@ -0,0 +1,52 @@
+import assert from 'node:assert/strict';
+import { readFileSync } from 'node:fs';
+
+const source = name => readFileSync(new URL(`../db/migrations/${name}.sql`, import.meta.url), 'utf8');
+
+export default async function ({ sql, json, check, repository }) {
+  const version = number => `trend-intelligence-v${number}-shadow`;
+  // Each entry is one snapshot; null stands for a row without trend_intelligence.
+  const stored = [[null], [{}], [version(6)], [version(7)], [version(8)], [version(6), version(8)], [null, version(7)],
+    ['trend-intelligence-v8'], ['trend-intelligence-v8-shadow-2'], ['intelligence-v8-shadow'], ['trend-intelligence-vx-shadow'],
+    ['trend-intelligence-v-shadow'], ['Trend-Intelligence-V8-Shadow'], [''], [version(99999999999)]];
+  const later = [[version(9)], [version(10)], [version(6), version(9)]];
+  const save = (rows, index) => {
+    const id = `29000000-0000-4000-8000-${String(index + 1).padStart(12, '0')}`;
+    const capturedAt = new Date(Date.UTC(2026, 8, 1) + index * 7200000).toISOString();
+    const values = rows.map((row, rank) => {
+      const fullName = `floor/project-${rank}`;
+      const payload = repository({ full_name: fullName, rank: rank + 1,
+        ...(row === null ? {} : { trend_intelligence: typeof row === 'string' ? { score_version: row } : row }) });
+      return `('${id}','${capturedAt}','${fullName}',${rank + 1},100,$p$${JSON.stringify(payload)}$p$::jsonb)`;
+    });
+    sql(`begin; set local role collector;
+      insert into radar.collector_runs(id,started_at,finished_at,status) values('${id}','${capturedAt}','${capturedAt}','completed');
+      insert into radar.snapshots(id,captured_at,source,repository_count) values('${id}','${capturedAt}','version-floor-test',${rows.length});
+      insert into radar.snapshot_repositories(snapshot_id,captured_at,full_name,rank,stars,payload_json) values ${values.join(',')}; commit;`);
+    return id;
+  };
+  const summary = id => json(`select to_jsonb(s) from radar.snapshot_summary s where snapshot_id='${id}'`);
+  const reference = id => {
+    sql(`select radar.refresh_snapshot_summary_reference('${id}')`);
+    return summary(id);
+  };
+
+  await check('029 version floor keeps every 021 result for stored versions and counts later versions', () => {
+    const original = source('021_v8_classification').match(/create or replace function radar\.refresh_snapshot_summary[\s\S]*?\n\$\$;/)[0];
+    sql(original.replace('radar.refresh_snapshot_summary(', 'radar.refresh_snapshot_summary_reference('));
+    const classified = [];
+    stored.forEach((rows, index) => {
+      const id = save(rows, index);
+      const current = summary(id);
+      assert.deepEqual(current, reference(id));
+      if (current.classification_available) classified.push(index);
+    });
+    assert.deepEqual(classified, [3, 4, 5, 6]);
+    later.forEach((rows, index) => {
+      const id = save(rows, stored.length + index);
+      const current = summary(id);
+      assert.equal(current.classification_available, true);
+      assert.deepEqual(reference(id), { ...current, classification_available: false });
+    });
+  });
+}
