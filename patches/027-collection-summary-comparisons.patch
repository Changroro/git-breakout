diff --git a/deploy/oracle/db/migrations/027_collection_summary_comparisons.sql b/deploy/oracle/db/migrations/027_collection_summary_comparisons.sql
new file mode 100644
index 0000000..c3392f9
--- /dev/null
+++ b/deploy/oracle/db/migrations/027_collection_summary_comparisons.sql
@@ -0,0 +1,43 @@
+begin;
+
+create or replace function radar.collection_context_data(p_full_names text[], p_observations boolean)
+returns jsonb language sql stable set search_path=pg_catalog,radar as $$
+  with policy as (select * from radar.collector_settings where id),
+  latest as (select max(captured_at) as captured_at from radar.snapshots),
+  summaries as (
+    select s.*,
+      -- A repository unseen since the threshold compares against its latest row; capture times are unique.
+      case when s.latest_captured_at<=latest.captured_at-make_interval(days=>policy.retention_growth_days)
+        then s.latest_captured_at else comparison.captured_at end as growth_comparison_captured_at,
+      case when s.latest_captured_at<=latest.captured_at-make_interval(days=>policy.retention_growth_days)
+        then s.latest_stars else comparison.stars end as growth_comparison_stars,
+      case when p_observations then (
+        select jsonb_agg(jsonb_build_object('captured_at',o.captured_at,'stars',o.stars) order by o.captured_at desc)
+        from (select captured_at,stars from radar.snapshot_repositories r
+          where r.full_name_key=s.full_name_key order by captured_at desc limit 20) o
+      ) else '[]'::jsonb end as observations
+    from radar.repository_state s cross join policy cross join latest
+    left join lateral (select captured_at,stars from radar.snapshot_repositories r
+      where s.latest_captured_at>latest.captured_at-make_interval(days=>policy.retention_growth_days)
+        and r.full_name_key=s.full_name_key and r.captured_at<=latest.captured_at-make_interval(days=>policy.retention_growth_days)
+      order by captured_at desc limit 1) comparison on true
+    where p_full_names is null or s.full_name_key=any(p_full_names)
+  )
+  select jsonb_build_object(
+    'latest_captured_at',(select captured_at from latest),
+    'interval_minutes',(select interval_minutes from policy),
+    'retention_policy',(select jsonb_build_object('grace_days',retention_grace_days,'growth_days',retention_growth_days,
+      'push_days',retention_push_days,'repository_limit',retention_repository_limit) from policy),
+    'repositories',coalesce((select jsonb_agg(jsonb_build_object(
+      'full_name',full_name,'first_seen_at',first_seen_at,'first_observed_stars',first_observed_stars,
+      'first_observation_was_trending',first_observation_was_trending,'official_trending_episode_count',official_trending_episode_count,
+      'latest_captured_at',latest_captured_at,'latest_pushed_at',latest_pushed_at,'latest_rank',latest_rank,'latest_stars',latest_stars,
+      'growth_comparison_captured_at',growth_comparison_captured_at,'growth_comparison_stars',growth_comparison_stars,
+      'observations',observations) order by full_name_key) from summaries),'[]'::jsonb)
+  );
+$$;
+revoke execute on function radar.collection_context_data(text[],boolean) from public;
+grant execute on function radar.collection_context_data(text[],boolean) to collector;
+
+notify pgrst, 'reload schema';
+commit;
