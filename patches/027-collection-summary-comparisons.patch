diff --git a/deploy/oracle/tests/regression-027.mjs b/deploy/oracle/tests/regression-027.mjs
new file mode 100644
index 0000000..4bd573e
--- /dev/null
+++ b/deploy/oracle/tests/regression-027.mjs
@@ -0,0 +1,38 @@
+import assert from 'node:assert/strict';
+import { readFileSync } from 'node:fs';
+
+const source = name => readFileSync(new URL(`../db/migrations/${name}.sql`, import.meta.url), 'utf8');
+
+export default async function ({ sql, json, check, repository }) {
+  await check('027 collection summary matches the per-row growth comparison exactly', () => {
+    const original = source('013_repository_state').match(/create or replace function radar\.collection_context_data[\s\S]*?\n\$\$;/)[0];
+    sql(original.replace('radar.collection_context_data(', 'radar.collection_context_reference('));
+    const names = ['stale/project', 'recent/project', 'fresh/project', 'gap/project'];
+    let sequence = 0;
+    for (let day = 0; day < 20; day += 1) {
+      sequence += 1;
+      const id = `27000000-0000-4000-8000-${String(sequence).padStart(12, '0')}`;
+      const capturedAt = new Date(Date.UTC(2026, 8, 1) + day * 86400000).toISOString();
+      const present = names.filter(name => name === 'stale/project' ? day < 5 : name === 'fresh/project' ? day >= 16
+        : name === 'gap/project' ? day < 3 || day >= 18 : true);
+      const rows = present.map((name, index) => `('${id}','${capturedAt}','${name}',${index + 1},${100 * (index + 1) + day},
+        $p$${JSON.stringify(repository({ full_name: name, rank: index + 1 }))}$p$::jsonb)`).join(',');
+      sql(`begin; set local role collector;
+        insert into radar.collector_runs(id,started_at,finished_at,status) values('${id}','${capturedAt}','${capturedAt}','completed');
+        insert into radar.snapshots(id,captured_at,source,repository_count) values('${id}','${capturedAt}','summary-test',${present.length});
+        insert into radar.snapshot_repositories(snapshot_id,captured_at,full_name,rank,stars,payload_json) values ${rows}; commit;`);
+    }
+    const compare = args => assert.deepEqual(json(`set role collector; select radar.collection_context_data(${args})`),
+      json(`select radar.collection_context_reference(${args})`));
+    compare('null, false');
+    compare('null, true');
+    compare("array['gap/project','fresh/project'], true");
+    const summary = json('set role collector; select api.collection_summary()').repositories;
+    const growth = Object.fromEntries(summary.map(row => [row.full_name, row.growth_comparison_captured_at]));
+    assert.equal(growth['stale/project'], '2026-09-05T00:00:00+00:00');
+    assert.equal(growth['recent/project'], '2026-09-13T00:00:00+00:00');
+    assert.equal(growth['fresh/project'], null);
+    assert.equal(growth['gap/project'], '2026-09-03T00:00:00+00:00');
+    sql('drop function radar.collection_context_reference(text[], boolean)');
+  });
+}
