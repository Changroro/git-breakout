diff --git a/deploy/oracle/db/migrations/032_event_status_grace.sql b/deploy/oracle/db/migrations/032_event_status_grace.sql
new file mode 100644
--- /dev/null
+++ b/deploy/oracle/db/migrations/032_event_status_grace.sql
@@ -0,0 +1,58 @@
+begin;
+
+create or replace function api.service_status()
+returns jsonb
+language sql
+stable
+security definer
+set search_path = pg_catalog, radar
+set statement_timeout = '5s'
+as $$
+  with settings as (
+    select interval_minutes from radar.collector_settings where id
+  ), latest as (
+    select captured_at from radar.snapshots order by captured_at desc limit 1
+  ), latest_run as (
+    select started_at from radar.collector_runs where status = 'completed' order by started_at desc limit 1
+  ), failure as (
+    select finished_at from radar.collector_runs where status = 'failed' order by started_at desc limit 1
+  ), event_hours as (
+    select hour, h.bucket_at, h.rejected_line_count
+    from generate_series(
+      date_trunc('hour', now()) - interval '25 hours',
+      date_trunc('hour', now()) - interval '2 hours', interval '1 hour'
+    ) hour
+    left join radar.event_collection_hours h on h.bucket_at = hour
+  ), event_status as (
+    select count(*) filter (where bucket_at is null)::integer as missing_hours,
+      coalesce(bool_or(bucket_at is null and hour + interval '2 hours 10 minutes' <= now()), false) as overdue
+    from event_hours
+  )
+  select jsonb_build_object(
+    'schema_version', '1.0',
+    'status', case when latest.captured_at is null
+      or now() - latest.captured_at > make_interval(mins => settings.interval_minutes * 2)
+      or event_status.overdue
+      then 'degraded' else 'ok' end,
+    'latest_snapshot_at', latest.captured_at,
+    'snapshot_age_seconds', case when latest.captured_at is null then null
+      else greatest(0, extract(epoch from now() - latest.captured_at)) end,
+    'expected_interval_minutes', settings.interval_minutes,
+    'next_due_at', coalesce(latest_run.started_at + make_interval(mins => settings.interval_minutes), now()),
+    'last_failure', case when failure.finished_at is null then null else jsonb_build_object('at', failure.finished_at) end,
+    'events', jsonb_build_object(
+      'latest_completed_hour', (select max(bucket_at) from radar.event_collection_hours),
+      'missing_hours', event_status.missing_hours,
+      'excluded_invalid_names', (select coalesce(sum(rejected_line_count),0) from event_hours),
+      'source_complete', event_status.missing_hours = 0
+    )
+  )
+  from settings cross join event_status
+  left join latest on true left join latest_run on true left join failure on true;
+$$;
+
+revoke all on function api.service_status() from public;
+grant execute on function api.service_status() to web_anon, collector;
+
+notify pgrst, 'reload schema';
+commit;
