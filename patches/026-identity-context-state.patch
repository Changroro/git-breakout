diff --git a/deploy/oracle/db/migrations/026_identity_context_state.sql b/deploy/oracle/db/migrations/026_identity_context_state.sql
new file mode 100644
index 0000000..81d009f
--- /dev/null
+++ b/deploy/oracle/db/migrations/026_identity_context_state.sql
@@ -0,0 +1,291 @@
+begin;
+
+set local lock_timeout = '5s';
+-- Block collector inserts until the state backfill and its triggers are installed.
+lock table radar.snapshot_repositories in share row exclusive mode;
+
+create index if not exists snapshot_repositories_identity_context_idx on radar.snapshot_repositories
+  (snapshot_id, full_name_key) include (captured_at, rank, stars, identity_pushed_at, identity_is_trending);
+-- Observations are created only on insert, exactly for rows with a valid GitHub ID (019 backfill and
+-- record_repository_identity), so rows without one are the unobserved legacy history.
+create index if not exists snapshot_repositories_legacy_identity_idx on radar.snapshot_repositories
+  (full_name_key) include (snapshot_id, captured_at, rank, stars, identity_pushed_at, identity_is_trending)
+  where coalesce(jsonb_typeof(payload_json->'repository_id') <> 'string' or btrim(payload_json->>'repository_id') = '', true);
+-- The context reads recent rows through index-only scans, which need a current visibility map.
+alter table radar.snapshot_repositories set (autovacuum_vacuum_insert_scale_factor = 0.01);
+
+create table if not exists radar.repository_identity_state (
+  repository_id text primary key check (btrim(repository_id) <> ''),
+  verified_episode_count integer not null check (verified_episode_count >= 0),
+  latest_captured_at timestamptz not null,
+  latest_is_trending boolean not null
+);
+alter table radar.repository_identity_state enable row level security;
+alter table radar.repository_identity_state force row level security;
+drop policy if exists repository_identity_state_collector on radar.repository_identity_state;
+create policy repository_identity_state_collector on radar.repository_identity_state
+  for all to collector using (true) with check (true);
+grant select, insert, update, delete on radar.repository_identity_state to collector;
+
+-- verified_episode_count counts Trending entries in verified observations only, starting from a non-Trending state.
+create or replace function radar.rebuild_repository_identity_state(p_repository_ids text[])
+returns void language sql set search_path = pg_catalog, radar as $$
+  delete from radar.repository_identity_state where p_repository_ids is null or repository_id = any(p_repository_ids);
+  insert into radar.repository_identity_state(repository_id, verified_episode_count, latest_captured_at, latest_is_trending)
+  select repository_id, count(*) filter(where trending and not was_trending)::integer, max(captured_at),
+    (array_agg(trending order by captured_at desc))[1]
+  from (
+    select i.repository_id, i.captured_at, r.identity_is_trending as trending,
+      lag(r.identity_is_trending, 1, false) over(partition by i.repository_id order by i.captured_at) as was_trending
+    from radar.repository_identity_observations i
+    join radar.snapshot_repositories r using(snapshot_id, full_name_key)
+    where p_repository_ids is null or i.repository_id = any(p_repository_ids)
+  ) o group by repository_id;
+$$;
+revoke execute on function radar.rebuild_repository_identity_state(text[]) from public;
+grant execute on function radar.rebuild_repository_identity_state(text[]) to collector;
+
+create or replace function radar.update_repository_identity_state()
+returns trigger language plpgsql set search_path = pg_catalog, radar as $$
+begin
+  perform radar.rebuild_repository_identity_state(ids) from (
+    select array_agg(distinct n.repository_id) as ids from new_rows n
+    left join radar.repository_identity_state s using(repository_id)
+    where s.repository_id is null or n.captured_at <= s.latest_captured_at
+  ) stale where ids is not null;
+  insert into radar.repository_identity_state(repository_id, verified_episode_count, latest_captured_at, latest_is_trending)
+  select repository_id, count(*) filter(where trending and not was_trending)::integer, max(captured_at),
+    (array_agg(trending order by captured_at desc))[1]
+  from (
+    select n.repository_id, n.captured_at, r.identity_is_trending as trending,
+      lag(r.identity_is_trending, 1, s.latest_is_trending) over(partition by n.repository_id order by n.captured_at) as was_trending
+    from new_rows n
+    join radar.repository_identity_state s using(repository_id)
+    join radar.snapshot_repositories r using(snapshot_id, full_name_key)
+    where n.captured_at > s.latest_captured_at
+  ) o group by repository_id
+  on conflict(repository_id) do update set
+    verified_episode_count = repository_identity_state.verified_episode_count + excluded.verified_episode_count,
+    latest_captured_at = excluded.latest_captured_at, latest_is_trending = excluded.latest_is_trending;
+  return null;
+end;
+$$;
+revoke execute on function radar.update_repository_identity_state() from public;
+drop trigger if exists update_repository_identity_state on radar.repository_identity_observations;
+create trigger update_repository_identity_state after insert on radar.repository_identity_observations
+referencing new table as new_rows for each statement execute function radar.update_repository_identity_state();
+
+create or replace function radar.refresh_repository_identity_state()
+returns trigger language plpgsql set search_path = pg_catalog, radar as $$
+begin
+  perform radar.rebuild_repository_identity_state(ids) from (
+    select array_agg(distinct i.repository_id) as ids from new_rows n
+    join radar.repository_identity_observations i using(snapshot_id, full_name_key)
+  ) changed where ids is not null;
+  return null;
+end;
+$$;
+revoke execute on function radar.refresh_repository_identity_state() from public;
+drop trigger if exists refresh_repository_identity_state on radar.snapshot_repositories;
+create trigger refresh_repository_identity_state after update on radar.snapshot_repositories
+referencing new table as new_rows for each statement execute function radar.refresh_repository_identity_state();
+
+select radar.rebuild_repository_identity_state(null);
+
+create or replace function api.repository_identity_context(p_repositories jsonb)
+returns jsonb language plpgsql stable set search_path = pg_catalog, radar as $$
+declare
+  result jsonb;
+begin
+  if jsonb_typeof(p_repositories) is distinct from 'array' then
+    raise exception 'Repository identity context requires an array';
+  end if;
+  if jsonb_array_length(p_repositories) not between 1 and 10000 then
+    raise exception 'Repository identity context requires 1-10000 repositories';
+  end if;
+  if exists(select 1 from jsonb_array_elements(p_repositories) r where
+      jsonb_typeof(r->'repository_id') is distinct from 'string' or btrim(r->>'repository_id') = ''
+      or jsonb_typeof(r->'full_name') is distinct from 'string' or (r->>'full_name') !~ '^[^/[:space:]]+/[^/[:space:]]+$'
+      or jsonb_typeof(r->'requested_names') is distinct from 'array') then
+    raise exception 'Invalid repository identity proof';
+  end if;
+  if exists(select 1 from jsonb_array_elements(p_repositories) r
+      cross join lateral jsonb_array_elements(r->'requested_names') n
+      where jsonb_typeof(n) <> 'string' or (n #>> '{}') !~ '^[^/[:space:]]+/[^/[:space:]]+$') then
+    raise exception 'Invalid requested repository name';
+  end if;
+  if exists(select 1 from jsonb_array_elements(p_repositories) r group by r->>'repository_id' having count(*) > 1)
+    or exists(select 1 from jsonb_array_elements(p_repositories) r group by lower(r->>'full_name') having count(*) > 1) then
+    raise exception 'Duplicate repository identity proof';
+  end if;
+  if exists(select 1 from jsonb_array_elements(p_repositories) r
+      left join radar.repository_identity_state s on s.repository_id = r->>'repository_id'
+      where s.latest_captured_at is distinct from (select max(i.captured_at) from radar.repository_identity_observations i
+        where i.repository_id = r->>'repository_id')) then
+    raise exception 'Repository identity state is out of date';
+  end if;
+
+  with requested as (
+    select r->>'repository_id' as repository_id, r->>'full_name' as full_name, r->'requested_names' as requested_names
+    from jsonb_array_elements(p_repositories) r
+  ), names as (
+    select repository_id, full_name as canonical_name, lower(full_name) as full_name_key from requested
+    union
+    select q.repository_id, q.full_name, lower(n) from requested q
+    cross join lateral jsonb_array_elements_text(q.requested_names) n
+    union
+    select q.repository_id, q.full_name, a.full_name_key from requested q
+    join radar.repository_identity_aliases a using(repository_id)
+  ), allowed_names as (
+    select n.* from names n where not exists(
+      select 1 from radar.repository_identity_aliases a
+      where a.full_name_key = n.full_name_key and a.repository_id <> n.repository_id
+    )
+  ), policy as (select * from radar.collector_settings where id limit 1),
+  latest as (select max(captured_at) as captured_at from radar.snapshots),
+  verified_first as (
+    select q.repository_id, f.captured_at, f.stars, f.trending from requested q
+    cross join lateral (select i.captured_at, r.stars, r.identity_is_trending as trending
+      from radar.repository_identity_observations i join radar.snapshot_repositories r using(snapshot_id, full_name_key)
+      where i.repository_id = q.repository_id order by i.captured_at limit 1) f
+  ), legacy as (
+    select n.repository_id, r.captured_at, r.rank, r.stars, r.identity_pushed_at as pushed_at, r.identity_is_trending as trending
+    from allowed_names n join radar.snapshot_repositories r using(full_name_key)
+    left join verified_first v on v.repository_id = n.repository_id
+    where coalesce(jsonb_typeof(r.payload_json->'repository_id') <> 'string' or btrim(r.payload_json->>'repository_id') = '', true)
+      -- Only rows at or after the first verified row can share a capture time with a verified row.
+      and (v.captured_at is null or r.captured_at < v.captured_at or not exists(
+        select 1 from radar.repository_identity_observations i
+        where i.repository_id = n.repository_id and i.captured_at = r.captured_at))
+  ),
+  -- Legacy rows after the first verified row break the append-only order, so those repositories use full history.
+  interleaved as (
+    select distinct l.repository_id from legacy l join verified_first v using(repository_id)
+    where l.captured_at > v.captured_at
+  ), full_history as (
+    select i.repository_id, r.captured_at, r.rank, r.stars, 'verified'::text as identity_status,
+      r.identity_pushed_at as pushed_at, r.identity_is_trending as trending
+    from interleaved x join radar.repository_identity_observations i using(repository_id)
+    join radar.snapshot_repositories r using(snapshot_id, full_name_key)
+    union all
+    select l.repository_id, l.captured_at, l.rank, l.stars, 'legacy_unverified', l.pushed_at, l.trending
+    from legacy l join interleaved x using(repository_id)
+  ), full_ordered as (
+    select *, row_number() over(partition by repository_id order by captured_at) as first_number,
+      row_number() over(partition by repository_id order by captured_at desc) as last_number,
+      lag(trending, 1, false) over(partition by repository_id order by captured_at) as was_trending
+    from full_history
+  ), full_summaries as (
+    select repository_id, min(captured_at) as first_seen_at,
+      case when bool_or(identity_status = 'legacy_unverified') then 'legacy_unverified' else 'verified' end as identity_status,
+      max(stars) filter(where first_number = 1) as first_observed_stars,
+      bool_or(trending) filter(where first_number = 1) as first_observation_was_trending,
+      count(*) filter(where trending and not was_trending)::integer as official_trending_episode_count,
+      max(captured_at) as latest_captured_at, max(rank) filter(where last_number = 1) as latest_rank,
+      max(stars) filter(where last_number = 1) as latest_stars,
+      max(pushed_at) filter(where last_number = 1) as latest_pushed_at,
+      jsonb_agg(jsonb_build_object('captured_at', captured_at, 'stars', stars) order by captured_at desc)
+        filter(where last_number <= 20) as observations
+    from full_ordered group by repository_id
+  ), full_comparisons as (
+    select distinct on(h.repository_id) h.repository_id, h.captured_at, h.stars
+    from full_history h cross join policy cross join latest
+    where h.captured_at <= latest.captured_at - make_interval(days => policy.retention_growth_days)
+    order by h.repository_id, h.captured_at desc
+  ), legacy_ordered as (
+    select l.*, row_number() over(partition by repository_id order by captured_at) as first_number,
+      row_number() over(partition by repository_id order by captured_at desc) as last_number,
+      lag(trending, 1, false) over(partition by repository_id order by captured_at) as was_trending
+    from legacy l where not exists(select 1 from interleaved x where x.repository_id = l.repository_id)
+  ), legacy_summaries as (
+    select repository_id, min(captured_at) as first_seen_at,
+      max(stars) filter(where first_number = 1) as first_stars, bool_or(trending) filter(where first_number = 1) as first_trending,
+      count(*) filter(where trending and not was_trending)::integer as episodes,
+      max(captured_at) as latest_captured_at, max(rank) filter(where last_number = 1) as latest_rank,
+      max(stars) filter(where last_number = 1) as latest_stars, max(pushed_at) filter(where last_number = 1) as latest_pushed_at,
+      bool_or(trending) filter(where last_number = 1) as latest_trending
+    from legacy_ordered group by repository_id
+  ), verified_summaries as (
+    select v.repository_id, v.captured_at as first_seen_at, v.stars as first_stars, v.trending as first_trending,
+      s.verified_episode_count as episodes, l.captured_at as latest_captured_at, l.rank as latest_rank,
+      l.stars as latest_stars, l.pushed_at as latest_pushed_at
+    from verified_first v join radar.repository_identity_state s using(repository_id)
+    cross join lateral (select r.captured_at, r.rank, r.stars, r.identity_pushed_at as pushed_at
+      from radar.repository_identity_observations i join radar.snapshot_repositories r using(snapshot_id, full_name_key)
+      where i.repository_id = v.repository_id order by i.captured_at desc limit 1) l
+    where not exists(select 1 from interleaved x where x.repository_id = v.repository_id)
+  ), appended_points as (
+    select q.repository_id, p.captured_at, p.stars from requested q
+    cross join lateral (select r.captured_at, r.stars
+      from radar.repository_identity_observations i join radar.snapshot_repositories r using(snapshot_id, full_name_key)
+      where i.repository_id = q.repository_id order by i.captured_at desc limit 20) p
+    where not exists(select 1 from interleaved x where x.repository_id = q.repository_id)
+    union all
+    select l.repository_id, l.captured_at, l.stars from legacy l
+    where not exists(select 1 from interleaved x where x.repository_id = l.repository_id)
+  ), appended_observations as (
+    select repository_id, jsonb_agg(jsonb_build_object('captured_at', captured_at, 'stars', stars) order by captured_at desc)
+      filter(where point_number <= 20) as observations
+    from (select *, row_number() over(partition by repository_id order by captured_at desc) as point_number
+      from appended_points) p group by repository_id
+  ),
+  -- Here every legacy row precedes every verified row, so the two summaries join end to end.
+  appended_summaries as (
+    select repository_id, coalesce(l.first_seen_at, v.first_seen_at) as first_seen_at,
+      case when l.repository_id is null then 'verified' else 'legacy_unverified' end as identity_status,
+      case when l.repository_id is null then v.first_stars else l.first_stars end as first_observed_stars,
+      case when l.repository_id is null then v.first_trending else l.first_trending end as first_observation_was_trending,
+      coalesce(l.episodes, 0) + coalesce(v.episodes, 0)
+        - case when l.latest_trending and v.first_trending then 1 else 0 end as official_trending_episode_count,
+      coalesce(v.latest_captured_at, l.latest_captured_at) as latest_captured_at,
+      case when v.repository_id is null then l.latest_rank else v.latest_rank end as latest_rank,
+      case when v.repository_id is null then l.latest_stars else v.latest_stars end as latest_stars,
+      case when v.repository_id is null then l.latest_pushed_at else v.latest_pushed_at end as latest_pushed_at,
+      o.observations
+    from verified_summaries v full join legacy_summaries l using(repository_id)
+    join appended_observations o using(repository_id)
+  ), appended_comparisons as (
+    select distinct on(c.repository_id) c.repository_id, c.captured_at, c.stars from (
+      select q.repository_id, p.captured_at, p.stars from requested q cross join policy cross join latest
+      cross join lateral (select r.captured_at, r.stars
+        from radar.repository_identity_observations i join radar.snapshot_repositories r using(snapshot_id, full_name_key)
+        where i.repository_id = q.repository_id
+          and i.captured_at <= latest.captured_at - make_interval(days => policy.retention_growth_days)
+        order by i.captured_at desc limit 1) p
+      where not exists(select 1 from interleaved x where x.repository_id = q.repository_id)
+      union all
+      select l.repository_id, l.captured_at, l.stars from legacy l cross join policy cross join latest
+      where l.captured_at <= latest.captured_at - make_interval(days => policy.retention_growth_days)
+        and not exists(select 1 from interleaved x where x.repository_id = l.repository_id)
+    ) c order by c.repository_id, c.captured_at desc
+  ), summaries as (
+    select q.full_name as canonical_name, s.* from (
+      select * from full_summaries union all select * from appended_summaries
+    ) s join requested q using(repository_id)
+  ), comparisons as (
+    select * from full_comparisons union all select * from appended_comparisons
+  )
+  select jsonb_build_object(
+    'latest_captured_at', (select captured_at from latest),
+    'interval_minutes', (select interval_minutes from policy),
+    'retention_policy', (select jsonb_build_object('grace_days', retention_grace_days, 'growth_days', retention_growth_days,
+      'push_days', retention_push_days, 'repository_limit', retention_repository_limit) from policy),
+    'repositories', coalesce((select jsonb_agg(jsonb_build_object(
+      'repository_id', s.repository_id, 'identity_status', s.identity_status, 'full_name', s.canonical_name,
+      'first_seen_at', s.first_seen_at, 'first_observed_stars', s.first_observed_stars,
+      'first_observation_was_trending', s.first_observation_was_trending,
+      'official_trending_episode_count', s.official_trending_episode_count,
+      'latest_captured_at', s.latest_captured_at, 'latest_rank', s.latest_rank, 'latest_stars', s.latest_stars,
+      'latest_pushed_at', s.latest_pushed_at, 'observations', s.observations,
+      'growth_comparison_captured_at', comparison.captured_at, 'growth_comparison_stars', comparison.stars
+    ) order by lower(s.canonical_name)) from summaries s
+    left join comparisons comparison using(repository_id)), '[]'::jsonb)
+  ) into result;
+  return result;
+end;
+$$;
+revoke execute on function api.repository_identity_context(jsonb) from public;
+grant execute on function api.repository_identity_context(jsonb) to collector;
+
+notify pgrst, 'reload schema';
+commit;
