index 0000000..8ddd7c5
--- /dev/null
+++ b/deploy/oracle/tests/regression-026.mjs
@@ -0,0 +1,101 @@
+import assert from 'node:assert/strict';
+import { readFileSync } from 'node:fs';
+
+const migration = name => readFileSync(new URL(`../db/migrations/${name}.sql`, import.meta.url), 'utf8');
+
+export default async function ({ sql, json, check, repository }) {
+  let sequence = 0;
+  function save(name, repositoryId, trending, day, aliases = [name]) {
+    sequence += 1;
+    const id = `26000000-0000-4000-8000-${String(sequence).padStart(12, '0')}`;
+    const capturedAt = new Date(Date.UTC(2026, 7, 1) + day * 86400000 + sequence * 1000).toISOString();
+    const value = repository({ full_name: name, pushed_at: capturedAt, stars: 1000 + sequence,
+      official_ranks: { daily: trending ? 1 : null, weekly: null, monthly: null } });
+    if (repositoryId !== null) Object.assign(value, { repository_id: repositoryId, repository_aliases: aliases });
+    sql(`begin; set local role collector;
+      insert into radar.collector_runs(id,started_at,finished_at,status) values('${id}','${capturedAt}','${capturedAt}','completed');
+      insert into radar.snapshots(id,captured_at,source,repository_count) values('${id}','${capturedAt}','identity-state-test',1);
+      insert into radar.snapshot_repositories(snapshot_id,captured_at,full_name,rank,stars,payload_json)
+      values('${id}','${capturedAt}','${name}',1,${1000 + sequence},$payload$${JSON.stringify(value)}$payload$::jsonb); commit;`);
+    return id;
+  }
+  const proofs = [
+    ['R_rename', 'rename/new', ['rename/old']], ['R_boundary', 'boundary/new', ['boundary/old']],
+    ['R_interleaved', 'interleaved/project', []], ['R_order', 'order/project', []], ['R_update', 'update/project', []],
+    ['R_long', 'long/project', []], ['R_legacy_only', 'legacy-only/project', []], ['R_reuse', 'reuse/project', []],
+    ['R_absent', 'absent/project', []], ['R_same', 'same/new', ['same/old']],
+  ].map(([repository_id, full_name, requested]) => ({ repository_id, full_name, requested_names: [full_name, ...requested] }));
+  const context = () => json(`set role collector; select api.repository_identity_context($proofs$${JSON.stringify(proofs)}$proofs$::jsonb)`);
+  const state = () => json(`select coalesce(jsonb_agg(to_jsonb(s) order by repository_id), '[]') from radar.repository_identity_state s`);
+  const byId = (value, id) => value.repositories.find(row => row.repository_id === id);
+
+  await check('026 append-only state matches the full-history identity context exactly', () => {
+    [true, false, true, true, false, true].forEach((trending, day) => save(day < 3 ? 'rename/old' : 'rename/new', 'R_rename', trending, day,
+      ['rename/old', 'rename/new']));
+    save('boundary/old', null, false, 0);
+    save('boundary/old', null, true, 1);
+    [true, false, true].forEach((trending, day) => save('boundary/new', 'R_boundary', trending, day + 2, ['boundary/old', 'boundary/new']));
+    save('interleaved/project', 'R_interleaved', true, 0);
+    save('interleaved/project', null, false, 1);
+    save('interleaved/project', 'R_interleaved', true, 2);
+    save('order/project', 'R_order', true, 4);
+    save('order/early', 'R_order', false, 2);
+    save('order/middle', 'R_order', true, 3);
+    save('update/project', 'R_update', true, 1);
+    const updated = save('update/project', 'R_update', false, 2);
+    save('update/project', 'R_update', true, 3);
+    for (let day = 0; day < 30; day += 1) save('long/project', 'R_long', day % 4 === 0, day);
+    save('legacy-only/project', null, true, 3);
+    save('legacy-only/project', null, true, 4);
+    save('reuse/project', 'R_reused_name', true, 5);
+    save('reuse/project', 'R_reuse', false, 40);
+    save('same/new', 'R_same', true, 0, ['same/new', 'same/old']);
+    const shared = '26000000-0000-4000-8000-000000000999';
+    const verified = JSON.stringify(repository({ full_name: 'same/new', repository_id: 'R_same', repository_aliases: ['same/new', 'same/old'] }));
+    const unverified = JSON.stringify(repository({ full_name: 'same/old', official_ranks: { daily: 2, weekly: null, monthly: null } }));
+    sql(`begin; set local role collector;
+      insert into radar.collector_runs(id,started_at,finished_at,status) values('${shared}','2026-08-02T12:00:00Z','2026-08-02T12:00:00Z','completed');
+      insert into radar.snapshots(id,captured_at,source,repository_count) values('${shared}','2026-08-02T12:00:00Z','identity-state-test',2);
+      insert into radar.snapshot_repositories(snapshot_id,captured_at,full_name,rank,stars,payload_json) values
+        ('${shared}','2026-08-02T12:00:00Z','same/new',1,10,$v$${verified}$v$::jsonb),
+        ('${shared}','2026-08-02T12:00:00Z','same/old',2,20,$u$${unverified}$u$::jsonb); commit;`);
+    sql(`update radar.snapshot_repositories set payload_json = jsonb_set(payload_json, '{official_ranks,daily}', '1')
+      where snapshot_id = '${updated}'`);
+
+    const after = context();
+    assert.equal(byId(after, 'R_rename').official_trending_episode_count, 3);
+    assert.equal(byId(after, 'R_boundary').official_trending_episode_count, 2);
+    assert.equal(byId(after, 'R_boundary').identity_status, 'legacy_unverified');
+    assert.equal(byId(after, 'R_interleaved').official_trending_episode_count, 2);
+    assert.equal(byId(after, 'R_order').official_trending_episode_count, 1);
+    assert.equal(byId(after, 'R_update').official_trending_episode_count, 1);
+    assert.equal(byId(after, 'R_long').observations.length, 20);
+    assert.equal(byId(after, 'R_legacy_only').official_trending_episode_count, 1);
+    assert.equal(byId(after, 'R_reuse').observations.length, 1);
+    assert.equal(byId(after, 'R_reuse').official_trending_episode_count, 0);
+    assert.equal(byId(after, 'R_long').official_trending_episode_count, 8);
+    assert.equal(byId(after, 'R_absent'), undefined);
+    assert.ok(byId(after, 'R_long').growth_comparison_captured_at);
+    assert.equal(byId(after, 'R_same').identity_status, 'verified');
+    assert.equal(byId(after, 'R_same').official_trending_episode_count, 1);
+
+    const incremental = state();
+    sql('select radar.rebuild_repository_identity_state(null)');
+    assert.deepEqual(state(), incremental);
+
+    sql(migration('023_identity_context_scalars'));
+    const before = context();
+    sql(migration('026_identity_context_state'));
+    assert.deepEqual(context(), before);
+    sql(migration('026_identity_context_state'));
+    assert.deepEqual(context(), before);
+    assert.deepEqual(state(), incremental);
+  });
+
+  await check('026 context fails loudly when stored identity state is stale', () => {
+    sql(`delete from radar.repository_identity_state where repository_id = 'R_long'`);
+    assert.throws(() => context(), /Repository identity state is out of date/);
+    sql(`select radar.rebuild_repository_identity_state(array['R_long'])`);
+    assert.ok(byId(context(), 'R_long'));
+  });
+}
