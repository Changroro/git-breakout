diff --git a/deploy/oracle/tests/regression-028.mjs b/deploy/oracle/tests/regression-028.mjs
new file mode 100644
index 0000000..28513df
--- /dev/null
+++ b/deploy/oracle/tests/regression-028.mjs
@@ -0,0 +1,99 @@
+import assert from 'node:assert/strict';
+import { readFileSync } from 'node:fs';
+
+const source = name => readFileSync(new URL(`../db/migrations/${name}.sql`, import.meta.url), 'utf8');
+const server = name => import(new URL(`../../../server/${name}.ts`, import.meta.url).href);
+const DAY = 86400000;
+const START = Date.UTC(2026, 8, 1);
+const OLD_PUSH = '2026-08-01T00:00:00Z';
+const range = (from, to) => day => day >= from && day <= to;
+// The last snapshot is day 44 (2026-10-15): grace starts 10-01, push starts 09-15, growth compares at 10-08.
+const repositories = {
+  'stale/project': { present: range(0, 4), pushed: '2026-09-01T00:00:00Z' },
+  'grace/project': { present: range(31, 33) },
+  'grace-edge/project': { present: range(30, 30) },
+  'grace-out/project': { present: range(29, 29) },
+  'pushed/project': { present: range(0, 10), pushed: '2026-09-20T00:00:00Z' },
+  'pushed-edge/project': { present: range(0, 2), pushed: '2026-09-15T00:00:00Z' },
+  'pushed-fraction/project': { present: range(0, 2), pushed: '2026-09-15T00:00:00.000Z' },
+  'pushed-out/project': { present: range(0, 2), pushed: '2026-09-14T23:59:59Z' },
+  'offset/project': { present: range(0, 2), pushed: '2026-09-20T09:00:00+09:00' },
+  'offset-old/project': { present: range(0, 2), pushed: '2026-08-01T09:00:00+09:00' },
+  'null-push/project': { present: range(0, 2), pushed: null },
+  'gained/project': { present: range(0, 44), stars: day => 100 + day },
+  'flat/project': { present: range(0, 44) },
+  'resumed/project': { present: day => day <= 2 || day >= 43, stars: day => 100 + day },
+  'dropped/project': { present: range(0, 36), stars: day => 100 + day },
+};
+const eligible = ['gained/project', 'grace-edge/project', 'grace/project', 'offset/project', 'pushed-edge/project',
+  'pushed-fraction/project', 'pushed/project', 'resumed/project'];
+const candidatesOnly = ['dropped/project', 'flat/project', 'offset-old/project', 'pushed-out/project'];
+
+export default async function ({ sql, json, check, repository }) {
+  const { parseCollectionContext } = await server('remote-history');
+  const { selectRetainedRepositoryNames } = await server('retention');
+  const retained = response => {
+    const context = parseCollectionContext(response);
+    return selectRetainedRepositoryNames(context.repositories, context.latestCapturedAt, context.retentionPolicy);
+  };
+  const summary = () => json('set role collector; select api.collection_summary()');
+  const reference = () => json('set role collector; select radar.collection_context_reference(null, false)');
+
+  await check('028 candidate summary retains the same repositories as the full summary', () => {
+    const original = source('013_repository_state').match(/create or replace function radar\.collection_context_data[\s\S]*?\n\$\$;/)[0];
+    sql(`${original.replace('radar.collection_context_data(', 'radar.collection_context_reference(')}
+      grant execute on function radar.collection_context_reference(text[], boolean) to collector;`);
+    assert.deepEqual(summary(), { ...reference(), observed_repository_count: 0 });
+    for (let day = 0; day < 45; day += 1) {
+      const id = `28000000-0000-4000-8000-${String(day + 1).padStart(12, '0')}`;
+      const capturedAt = new Date(START + day * DAY).toISOString();
+      const rows = Object.entries(repositories).filter(([, value]) => value.present(day)).map(([name, value], index) =>
+        `('${id}','${capturedAt}','${name}',${index + 1},${value.stars?.(day) ?? 100},$p$${JSON.stringify(repository({
+          full_name: name, rank: index + 1, pushed_at: value.pushed === undefined ? OLD_PUSH : value.pushed }))}$p$::jsonb)`);
+      sql(`begin; set local role collector;
+        insert into radar.collector_runs(id,started_at,finished_at,status) values('${id}','${capturedAt}','${capturedAt}','completed');
+        insert into radar.snapshots(id,captured_at,source,repository_count) values('${id}','${capturedAt}','candidate-test',${rows.length});
+        insert into radar.snapshot_repositories(snapshot_id,captured_at,full_name,rank,stars,payload_json) values ${rows.join(',')}; commit;`);
+    }
+    const compare = () => {
+      const [full, candidates] = [reference(), summary()];
+      const { repositories: fullRows, ...fullHeader } = full;
+      const { repositories: candidateRows, observed_repository_count: observed, ...candidateHeader } = candidates;
+      assert.deepEqual(candidateHeader, fullHeader);
+      assert.equal(observed, fullRows.length);
+      for (const row of candidateRows) assert.deepEqual(row, fullRows.find(other => other.full_name === row.full_name));
+      assert.deepEqual(retained(candidates), retained(full));
+      return { names: retained(candidates), candidateRows };
+    };
+    const first = compare();
+    assert.deepEqual([...first.names].sort(), eligible);
+    assert.deepEqual(first.candidateRows.map(row => row.full_name), [...eligible, ...candidatesOnly].sort());
+    sql('update radar.collector_settings set retention_repository_limit = 3');
+    assert.equal(compare().names.length, 3);
+    // A policy change moves the candidate windows with it.
+    sql('update radar.collector_settings set retention_repository_limit = 1000, retention_grace_days = 40, retention_push_days = 50, retention_growth_days = 20');
+    const widened = compare();
+    assert.ok(widened.names.includes('stale/project') && widened.names.includes('dropped/project'));
+    sql('update radar.collector_settings set retention_grace_days = 14, retention_push_days = 30, retention_growth_days = 7');
+  });
+
+  await check('028 summary reads candidates through indexes and reapplies cleanly', () => {
+    const body = source('028_retention_candidate_summary').match(/function api\.collection_summary\(\)[\s\S]*?\$\$\n([\s\S]*?)\n\$\$;/)[1];
+    const plan = sql(`set enable_seqscan = off; set enable_indexscan = off; set enable_indexonlyscan = off; explain ${body}`);
+    for (const index of ['repository_state_observed_idx', 'repository_state_pushed_idx', 'repository_state_unparsed_push_idx']) {
+      assert.match(plan, new RegExp(`Bitmap Index Scan on ${index}`));
+    }
+    const state = () => ({ summary: summary(),
+      settings: sql("select proconfig::text from pg_proc where oid = 'api.repository_identity_context(jsonb)'::regprocedure"),
+      indexes: sql(`select string_agg(indexname, ',' order by indexname) from pg_indexes where schemaname = 'radar'
+        and tablename in ('repository_state', 'snapshot_repositories', 'repository_identity_observations')`) });
+    const before = state();
+    assert.match(before.settings, /jit=off/);
+    assert.doesNotMatch(before.indexes, /snapshot_repositories_snapshot_idx|repository_identity_history_idx/);
+    assert.match(before.indexes, /snapshot_repositories_snapshot_id_rank_key/);
+    assert.match(before.indexes, /repository_identity_observations_repository_id_captured_at_key/);
+    sql(source('028_retention_candidate_summary'));
+    assert.deepEqual(state(), before);
+    sql('drop function radar.collection_context_reference(text[], boolean)');
+  });
+}
