diff --git a/deploy/oracle/db/migrations/025_classified_board_exposures.sql b/deploy/oracle/db/migrations/025_classified_board_exposures.sql
new file mode 100644
index 0000000..d4a5472
--- /dev/null
+++ b/deploy/oracle/db/migrations/025_classified_board_exposures.sql
@@ -0,0 +1,57 @@
+begin;
+
+-- 신규 발굴 분류(v7 이후)가 없는 스냅샷의 breakout 보드는 Star 1만 이상 저장소도 포함했으므로 노출로 세지 않는다.
+create or replace function radar.record_board_exposures(p_snapshot_id uuid)
+returns void language sql set search_path = pg_catalog, radar as $$
+  with board as (
+    select full_name_key, full_name, captured_at, stars,
+      row_number() over (
+        order by (payload_json #>> '{trend_intelligence,breakout,score}')::numeric desc, full_name_key
+      )::integer as position
+    from radar.snapshot_repositories
+    where snapshot_id = p_snapshot_id
+      and payload_json #> '{trend_intelligence,breakout,score}' <> 'null'::jsonb
+      and exists (
+        select 1 from radar.snapshot_summary
+        where snapshot_id = p_snapshot_id and classification_available
+      )
+  )
+  insert into radar.discovery_board_exposures as exposures (
+    full_name_key, full_name, first_board_at, first_board_rank, first_board_stars,
+    first_top10_at, first_top10_stars
+  )
+  select full_name_key, full_name, captured_at, position, stars,
+    case when position <= 10 then captured_at end,
+    case when position <= 10 then stars end
+  from board
+  on conflict (full_name_key) do update
+    set first_top10_at = excluded.first_top10_at, first_top10_stars = excluded.first_top10_stars
+    where exposures.first_top10_at is null and excluded.first_top10_at is not null;
+$$;
+revoke execute on function radar.record_board_exposures(uuid) from public;
+grant execute on function radar.record_board_exposures(uuid) to collector;
+
+delete from radar.discovery_board_exposures;
+
+do $$
+declare
+  snapshot record;
+begin
+  for snapshot in
+    select snapshots.id
+    from radar.snapshots
+    join radar.snapshot_summary summary on summary.snapshot_id = snapshots.id
+    where summary.classification_available
+    order by snapshots.captured_at
+  loop
+    perform radar.record_board_exposures(snapshot.id);
+  end loop;
+end;
+$$;
+select radar.settle_board_outcomes(max(captured_at)) from radar.snapshots having max(captured_at) is not null;
+
+insert into radar.track_record_summary(id, payload)
+select true, radar.compute_track_record() where exists (select 1 from radar.snapshots)
+on conflict (id) do update set payload = excluded.payload;
+
+commit;
diff --git a/deploy/oracle/tests/regression-025.mjs b/deploy/oracle/tests/regression-025.mjs
new file mode 100644
index 0000000..55e5161
--- /dev/null
+++ b/deploy/oracle/tests/regression-025.mjs
@@ -0,0 +1,42 @@
+import assert from 'node:assert/strict';
+import { readFileSync } from 'node:fs';
+
+const DAY = 24 * 60 * 60 * 1000;
+
+export default async function ({ sql, json, check, repository }) {
+  const at = days => new Date(Date.now() - days * DAY).toISOString();
+  let runIndex = 0;
+  function collect(capturedAt, rows) {
+    runIndex += 1;
+    const id = `25000000-0000-4000-8000-${String(runIndex).padStart(12, '0')}`;
+    sql(`set role collector;
+      select api.start_collection('${id}', '${capturedAt}');
+      select api.complete_collection('${id}', '${capturedAt}', 'fixture',
+        $payload$${JSON.stringify(rows.map((row, index) => ({ ...row, rank: index + 1 })))}$payload$::jsonb);`);
+  }
+  const board = (full_name, score, stars, scoreVersion) => repository({
+    full_name, stars, trend_intelligence: { ...(scoreVersion ? { score_version: scoreVersion } : {}), breakout: { score } },
+  });
+  const exposures = () => json(`select coalesce(jsonb_object_agg(full_name, jsonb_build_object(
+      'at', first_board_at, 'rank', first_board_rank)), '{}'::jsonb) from radar.discovery_board_exposures`);
+
+  await check('025 counts board exposures only from classified snapshots', () => {
+    collect(at(10), [board('big/old', 90, 50000), board('legacy/only', 80, 100)]);
+    const classifiedAt = at(9);
+    collect(classifiedAt, [board('new/one', 95, 100, 'trend-intelligence-v8-shadow'), board('big/old', 70, 50100, 'trend-intelligence-v8-shadow')]);
+    const recorded = exposures();
+    assert.deepEqual(Object.keys(recorded).sort(), ['big/old', 'new/one']);
+    assert.equal(recorded['big/old'].rank, 2);
+    assert.equal(Date.parse(recorded['big/old'].at), Date.parse(classifiedAt));
+  });
+
+  await check('025 rebuild drops unclassified exposures and is idempotent', () => {
+    sql(`insert into radar.discovery_board_exposures(full_name_key, full_name, first_board_at, first_board_rank, first_board_stars)
+      values ('legacy/only', 'legacy/only', now() - interval '10 days', 1, 100)`);
+    sql(readFileSync(new URL('../db/migrations/025_classified_board_exposures.sql', import.meta.url), 'utf8'));
+    const first = exposures();
+    assert.deepEqual(Object.keys(first).sort(), ['big/old', 'new/one']);
+    sql(readFileSync(new URL('../db/migrations/025_classified_board_exposures.sql', import.meta.url), 'utf8'));
+    assert.deepEqual(exposures(), first);
+  });
+}
